---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ImpulseGroup from '../components/sections/ImpulseGroup.astro';
import QueHacemos from '../components/sections/QueHacemos.astro';
import Marchas from '../components/sections/Marchas.astro';
import Vivir from '../components/sections/Vivir.astro';
import Proyectos from '../components/sections/Proyectos.astro';
import Activaciones from '../components/sections/Activaciones.astro';
import Chatbot from '../components/sections/Chatbot.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';

const description =
  'Impulse Buenos Aires — Comunidad LGBTIQ+, salud sexual y prevención del VIH en Buenos Aires. Eventos, activaciones y proyectos.';
---

<BaseLayout title="Inicio" description={description}>
  <Hero />
  <a href="/formacion" class="block bg-accent hover:bg-accent-hover transition-colors">
    <p class="container py-4 text-center text-white font-semibold">
      Ciclo de Formación: virtual y gratuito. Inscripción abierta →
    </p>
  </a>
  <Chatbot />
  <ImpulseGroup />
  <QueHacemos />
  <Marchas />
  <Vivir />
  <Proyectos />
  <Activaciones />
  <CtaBlock />
</BaseLayout>
