---
import BaseLayout from '../components/layout/BaseLayout.astro';

const heroVideos = [
  {
    id: '1191384379',
    title: 'Arte como activismo — Impulse Buenos Aires (1)',
  },
  {
    id: '1193278401',
    title: 'Arte como activismo — Impulse Buenos Aires (2)',
  },
  {
    id: '1193278648',
    title: 'Arte como activismo — Impulse Buenos Aires (3)',
  },
];
const vimeoFlags = 'autoplay=1&loop=1&muted=1&playsinline=1&byline=0&title=0&portrait=0&dnt=1';

const vivirThumb = '/images/arte/VIHVIR__2_.jpg';

const description =
  'Conversatorios, muestras y producciones culturales de Impulse Buenos Aires. El arte como herramienta política, identitaria y de cuidado en la comunidad LGBTIQ+.';
---

<BaseLayout title="Arte como activismo" description={description}>
  <!-- Hero con 3 videos verticales -->
  <section class="hero">
    <div class="container hero-content">
      <p class="hero-eyebrow">Arte y cultura · En curso</p>
      <h1 class="hero-title">Arte como activismo.</h1>
      <p class="hero-subtitle">
        El arte como herramienta política, identitaria y de cuidado.
      </p>

      <div class="hero-videos">
        {
          heroVideos.map((v) => (
            <div class="hero-video-frame">
              <iframe
                src={`https://player.vimeo.com/video/${v.id}?${vimeoFlags}`}
                title={v.title}
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
                allowfullscreen
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro">
    <div class="container intro-content">
      <p class="eyebrow">Lo que hacemos</p>
      <h2 class="intro-title">
        El arte llega donde no llegan los folletos.
      </h2>
      <p class="intro-text">
        En Impulse usamos el arte para abrir conversaciones que muchas
        veces no encuentran lugar en otros espacios. Conversatorios,
        muestras fotográficas, intervenciones urbanas, producciones
        audiovisuales — cada formato es una excusa para hablar de salud
        sexual, identidad, vínculos y comunidad sin filtros y sin
        solemnidad.
      </p>
      <p class="intro-text">
        Cada proyecto cultural que armamos parte de una idea simple:
        cuando algo te atraviesa estéticamente, también te atraviesa
        políticamente. Por eso trabajamos con artistas locales, ocupamos
        instituciones, salimos a la calle y armamos espacios donde la
        comunidad LGBTIQ+ pueda mirarse, reconocerse y discutirse.
      </p>
    </div>
  </section>

  <!-- Banner Vivir -->
  <section class="featured-project">
    <div class="container">
      <a href="/vivir" class="featured-card">
        <div class="featured-media">
          <img src={vivirThumb} alt="Vivir — muestra fotográfica en la Legislatura porteña" />
        </div>
        <div class="featured-body">
          <p class="featured-eyebrow">Muestra destacada · 2024</p>
          <h3 class="featured-title">Vivir</h3>
          <p class="featured-text">
            Muestra fotográfica en la Legislatura de la Ciudad de Buenos
            Aires por el Día Internacional del Orgullo. Tres personajes,
            siete imágenes, una pregunta sobre identidad y libertad.
          </p>
          <span class="featured-cta" aria-hidden="true">Ver muestra →</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    background-color: var(--color-bg);
    padding: 8rem 0 4rem;
    margin-top: -5rem;
  }
  @media (min-width: 768px) {
    .hero {
      padding: 10rem 0 6rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .hero-videos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
    max-width: 360px;
    justify-items: center;
  }
  @media (min-width: 640px) {
    .hero-videos {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      max-width: 100%;
    }
  }
  @media (min-width: 1024px) {
    .hero-videos {
      gap: 1.5rem;
    }
  }

  .hero-video-frame {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 9 / 16;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }

  .hero-video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ---------- Intro ---------- */
  .intro {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .intro { padding: 6rem 0; }
  }

  .intro-content {
    max-width: 720px;
  }

  .eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .intro-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .intro-text + .intro-text {
    margin-top: 1.25rem;
  }

  /* ---------- Featured project (Vivir banner) ---------- */
  .featured-project {
    background-color: var(--color-bg);
    padding: 0 0 6rem;
  }
  @media (min-width: 768px) {
    .featured-project { padding: 0 0 8rem; }
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition);
  }
  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 1fr 1.2fr;
      align-items: stretch;
    }
  }
  .featured-card:hover,
  .featured-card:focus-visible {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .featured-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .featured-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-2);
  }
  @media (min-width: 768px) {
    .featured-media { aspect-ratio: auto; }
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .featured-card:hover .featured-media img {
    transform: scale(1.03);
  }

  .featured-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .featured-body { padding: 3rem; }
  }

  .featured-eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .featured-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .featured-text {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .featured-cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: color var(--transition), border-color var(--transition);
  }
  .featured-card:hover .featured-cta,
  .featured-card:focus-visible .featured-cta {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
</style>
