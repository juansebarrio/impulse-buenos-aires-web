---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../components/layout/BaseLayout.astro';

const heroImage = '/images/marchas/PRIDE-IMPULSE_LOGO_x__ligiamajul-40.jpg';
const featuredLeft = '/images/marchas/PRIDE-IMPULSE_LOGO_x__ligiamajul-40.jpg';
const featuredRight = '/images/marchas/PRIDE-IMPULSE_LOGO_x__ligiamajul-14.jpg';

const featuredFilenames = [
  'PRIDE-IMPULSE_LOGO_x__ligiamajul-40.jpg',
  'PRIDE-IMPULSE_LOGO_x__ligiamajul-14.jpg',
];

const marchasDir = path.join(process.cwd(), 'public/images/marchas');
const galleryFiles = fs
  .readdirSync(marchasDir)
  .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
  .filter((f) => !featuredFilenames.includes(f))
  .sort();
const galleryUrls = galleryFiles.map((f) => `/images/marchas/${f}`);

const description =
  'Impulse Buenos Aires participa de la Marcha del Orgullo desde 2017, integrando la comisión organizadora y llevando su carroza con artistas locales.';
---

<BaseLayout title="Marcha del Orgullo" description={description}>
  <!-- Hero -->
  <section class="hero" style={`background-image: url('${heroImage}');`}>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <p class="hero-eyebrow">Cada noviembre · Desde 2017</p>
      <h1 class="hero-title">
        Más de 9 años en<br />la Marcha del Orgullo.
      </h1>
      <p class="hero-subtitle">
        Somos parte de la comisión organizadora y llevamos nuestra carroza
        para mostrar lo mejor de les artistas locales.
      </p>
    </div>
    <a href="#intro" class="scroll-indicator" aria-label="Bajar">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="28"
        height="28"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </a>
  </section>

  <!-- Intro -->
  <section id="intro" class="intro">
    <div class="container intro-content">
      <p class="eyebrow">Nuestra historia</p>
      <h2 class="intro-title">No somos espectadores. Somos parte.</h2>
      <p class="intro-text">
        Desde que llegamos a Buenos Aires integramos la comisión
        organizadora de la Marcha del Orgullo. Año tras año sumamos nuestra
        carroza como espacio de visibilidad, arte y mensaje. Un lugar donde
        la comunidad se encuentra, celebra y exige.
      </p>
    </div>
  </section>

  <!-- Featured doble -->
  <section class="featured">
    <div class="featured-grid">
      <div class="featured-item">
        <img
          src={featuredLeft}
          alt="Pieza de campaña Marcha del Orgullo — Impulse Buenos Aires (1)"
        />
      </div>
      <div class="featured-item">
        <img
          src={featuredRight}
          alt="Pieza de campaña Marcha del Orgullo — Impulse Buenos Aires (2)"
        />
      </div>
    </div>
  </section>

  <!-- Galería -->
  <section class="gallery-section">
    <div class="container">
      <p class="eyebrow">Galería</p>
      <div class="gallery">
        {
          galleryUrls.map((src, i) => (
            <button class="gallery-item" data-index={i} aria-label={`Abrir foto ${i + 1}`}>
              <img
                src={src}
                alt={`Marcha del Orgullo — foto ${i + 1}`}
                loading="lazy"
              />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog id="lightbox" class="lightbox" aria-label="Visor de fotos">
    <button class="lightbox-close" aria-label="Cerrar visor">×</button>
    <button class="lightbox-prev" aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <img class="lightbox-img" alt="" />
    <button class="lightbox-next" aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </dialog>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    margin-top: -5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1rem;
    background-color: var(--color-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1),
      rgba(0, 0, 0, 0.75)
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 960px;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 20px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    max-width: 520px;
    margin: 0 auto;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-white);
    z-index: 2;
    transition: opacity 0.3s ease;
  }
  .scroll-indicator svg {
    animation: bounce 2s ease-in-out infinite;
  }
  .scroll-indicator.is-faded {
    opacity: 0;
    pointer-events: none;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(8px); }
  }

  /* ---------- Intro ---------- */
  .intro {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .intro { padding: 6rem 0; }
  }

  .intro-content {
    max-width: 720px;
  }

  .eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .intro-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ---------- Featured doble ---------- */
  .featured {
    background-color: var(--color-bg);
    padding-bottom: 4rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .featured-item img {
    display: block;
    width: 100%;
    height: 380px;
    object-fit: cover;
  }
  @media (min-width: 768px) {
    .featured-item img {
      height: 600px;
    }
  }

  /* ---------- Galería ---------- */
  .gallery-section {
    background-color: var(--color-bg);
    padding: 4rem 0 6rem;
  }
  @media (min-width: 768px) {
    .gallery-section {
      padding: 4rem 0 6rem;
    }
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .gallery-item {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .gallery-item {
      aspect-ratio: auto;
      height: 320px;
    }
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }
  .gallery-item:hover img {
    transform: scale(1.04);
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.95);
    color: var(--color-white);
    inset: 0;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.95);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: transparent;
    border: 0;
    color: var(--color-white);
    cursor: pointer;
    padding: 0.75rem;
    line-height: 1;
    transition: opacity var(--transition);
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 0.7;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
    font-size: 2rem;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    display: none;
  }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  @media (min-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      display: block;
    }
  }
</style>

<script>
  // Scroll indicator fade-out
  const indicator = document.querySelector('.scroll-indicator');
  if (indicator) {
    const onScroll = () => {
      if (window.scrollY > 50) indicator.classList.add('is-faded');
      else indicator.classList.remove('is-faded');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const lbImg = lightbox.querySelector('.lightbox-img');
    const closeBtn = lightbox.querySelector('.lightbox-close');
    const prevBtn = lightbox.querySelector('.lightbox-prev');
    const nextBtn = lightbox.querySelector('.lightbox-next');
    const items = Array.from(document.querySelectorAll('.gallery-item'));
    const sources = items.map((b) => b.querySelector('img').src);
    const alts = items.map((b) => b.querySelector('img').alt);
    let idx = 0;

    const render = () => {
      lbImg.src = sources[idx];
      lbImg.alt = alts[idx];
    };
    const open = (i) => {
      idx = i;
      render();
      lightbox.showModal();
    };
    const close = () => lightbox.close();
    const prev = () => {
      idx = (idx - 1 + sources.length) % sources.length;
      render();
    };
    const next = () => {
      idx = (idx + 1) % sources.length;
      render();
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    // Click outside image (on the dialog itself, not on inner elements)
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    // Arrow keys
    document.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    // Swipe mobile
    let touchStartX = 0;
    lightbox.addEventListener(
      'touchstart',
      (e) => { touchStartX = e.changedTouches[0].screenX; },
      { passive: true }
    );
    lightbox.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(dx) > 50) {
        if (dx > 0) prev();
        else next();
      }
    });
  }
</script>
