---
import BaseLayout from '../components/layout/BaseLayout.astro';

const vimeoId = '1191383889';
const vimeoEmbed = `https://player.vimeo.com/video/${vimeoId}?autoplay=1&loop=1&muted=1&playsinline=1&byline=0&title=0&portrait=0&dnt=1`;
const legislaturaLogo = '/images/logos/logo-lcaba.png';

const gallery = [
  '/images/arte/VIHVIR__2_.jpg',
  '/images/arte/VIHVIR__3_.jpg',
  '/images/arte/VIHVIR__4_.jpg',
  '/images/arte/VIHVIR__5_.jpg',
  '/images/arte/VIHVIR__6_.jpg',
  '/images/arte/VIHVIR__8_.jpg',
  '/images/arte/VIHVIR__9_.jpg',
];

const description =
  'Vivir es una muestra fotográfica de Impulse Buenos Aires presentada en la Legislatura de la Ciudad en el Día del Orgullo 2024. Tres personajes, siete imágenes, una pregunta sobre identidad y libertad.';
---

<BaseLayout
  title="Vivir — Muestra fotográfica"
  description={description}
  ogImage="/images/arte/VIHVIR__2_.jpg"
>
  <!-- 1. Intro -->
  <section class="intro">
    <div class="container intro-content">
      <p class="eyebrow eyebrow-accent">Día Internacional del Orgullo · 2024</p>
      <h1 class="hero-title">Vivir.</h1>
      <p class="hero-subtitle">
        Una muestra fotográfica en la Legislatura de la Ciudad de Buenos
        Aires. Un espacio que cada une puede definir, trazar y ocupar
        para su propia construcción identitaria.
      </p>
    </div>
  </section>

  <!-- 2. Video -->
  <section class="video-section">
    <div class="hero-video-wrap">
      <iframe
        class="hero-video"
        src={vimeoEmbed}
        title="Vivir — Muestra en la Legislatura porteña 2024"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
        allowfullscreen
      ></iframe>
    </div>
    <div class="container video-caption">
      <p>Legislatura de la Ciudad de Buenos Aires · 2024</p>
    </div>
  </section>

  <!-- 3. Texto del proyecto -->
  <section class="project">
    <div class="container">
      <div class="project-grid">
        <div class="project-col project-col-left">
          <p class="eyebrow">La muestra</p>
          <h2 class="project-title">Poder vivir nuestra identidad con orgullo.</h2>
          <p class="project-text">
            En el marco del Día Internacional del Orgullo 2024, realizamos
            una muestra fotográfica en la Legislatura de la Ciudad de
            Buenos Aires. La exposición refleja las fotografías de tres
            personajes con el fin de desestigmatizar el autodescubrimiento
            del género y la sexualidad.
          </p>
        </div>

        <div class="project-col project-col-right">
          <p class="eyebrow">Sobre el proyecto</p>
          <p class="project-text">
            A través de les tres personajes queremos desestigmatizar el
            autodescubrimiento del género y la sexualidad, donde en la
            cotidianidad somos seres sintientes, cargados de dualidades,
            anhelos, subjetividades y vivencias que nos caracterizan como
            sujetes.
          </p>
          <p class="project-text">
            Es en la individualidad que deberíamos poder decidir qué y
            quiénes somos; qué mostramos a la otredad sin que sea ella la
            que nos defina. Vivir no debería ser más que el espacio que
            cada une desea trazar para su propia construcción identitaria.
          </p>
          <p class="project-note">
            El proyecto está conformado por 7 imágenes donde se retratan
            3 personajes en una relación íntima con la cámara. Las
            situaciones de movimiento juegan con la reversibilidad del
            género y el camino del autodescubrimiento.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Logo Legislatura -->
  <section class="legislatura">
    <div class="container legislatura-content">
      <p class="legislatura-label">Con el apoyo de</p>
      <img
        src={legislaturaLogo}
        alt="Legislatura de la Ciudad Autónoma de Buenos Aires"
        class="legislatura-logo"
      />
    </div>
  </section>

  <!-- 5. Galería -->
  <section class="gallery-section">
    <div class="container gallery-header">
      <p class="eyebrow eyebrow-accent">La exposición</p>
      <h2 class="gallery-title">
        7 imágenes. 3 personajes. Una sola pregunta.
      </h2>
    </div>

    <div class="gallery">
      {
        gallery.map((src, i) => (
          <button class="gallery-item" data-index={i} aria-label={`Abrir foto ${i + 1}`}>
            <img src={src} alt={`Vivir — foto ${i + 1}`} loading="lazy" />
          </button>
        ))
      }
    </div>
  </section>

  <!-- Lightbox -->
  <dialog id="lightbox" class="lightbox" aria-label="Visor de fotos">
    <button class="lightbox-close" aria-label="Cerrar visor">×</button>
    <button class="lightbox-prev" aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <img class="lightbox-img" alt="" />
    <button class="lightbox-next" aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </dialog>
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .intro {
    background-color: #000;
    padding: 5rem 0 2.5rem;
  }

  .intro-content {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow,
  .eyebrow-accent {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .eyebrow {
    color: var(--color-accent);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 11vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-white);
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ---------- Video ---------- */
  .video-section {
    background-color: #000;
  }

  .hero-video-wrap {
    position: relative;
    width: 100%;
    background: #000;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 768px) {
    .hero-video-wrap {
      aspect-ratio: auto;
      height: 80vh;
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .video-caption {
    padding-top: 1rem;
    padding-bottom: 1rem;
    text-align: right;
  }
  .video-caption p {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  /* ---------- Proyecto (dos columnas) ---------- */
  .project {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .project { padding: 6rem 0; }
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .project-col-left {
      border-right: 1px solid var(--color-border);
      padding-right: 3rem;
    }
    .project-col-right {
      padding-left: 3rem;
    }
  }

  .project-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 4.5vw, 48px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .project-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .project-text + .project-text {
    margin-top: 1.25rem;
  }

  .project-note {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
    opacity: 0.8;
  }

  /* ---------- Legislatura ---------- */
  .legislatura {
    background-color: var(--color-surface);
    padding: 3rem 0;
  }
  @media (min-width: 768px) {
    .legislatura { padding: 4rem 0; }
  }

  .legislatura-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .legislatura-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
  }

  .legislatura-logo {
    max-width: 280px;
    width: 100%;
    height: auto;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  /* ---------- Galería ---------- */
  .gallery-section {
    background-color: #000;
    padding: 5rem 0 6rem;
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gallery-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.1;
    color: var(--color-white);
    letter-spacing: -0.02em;
    max-width: 720px;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: auto;
    gap: 4px;
  }

  .gallery-item {
    display: block;
    padding: 0;
    border: 0;
    background: var(--color-surface);
    overflow: hidden;
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gallery-item:hover img {
    transform: scale(1.03);
  }

  /* Posiciones del grid editorial */
  .gallery-item:nth-child(1) {
    grid-column: 1 / -1;
    height: 70vh;
  }
  .gallery-item:nth-child(2),
  .gallery-item:nth-child(3),
  .gallery-item:nth-child(4) {
    grid-column: span 2;
    height: 400px;
  }
  .gallery-item:nth-child(5),
  .gallery-item:nth-child(6) {
    grid-column: span 3;
    height: 500px;
  }
  .gallery-item:nth-child(7) {
    grid-column: 1 / -1;
    height: 60vh;
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: 1fr;
    }
    .gallery-item:nth-child(1),
    .gallery-item:nth-child(2),
    .gallery-item:nth-child(3),
    .gallery-item:nth-child(4),
    .gallery-item:nth-child(5),
    .gallery-item:nth-child(6),
    .gallery-item:nth-child(7) {
      grid-column: 1 / -1;
      height: auto;
      aspect-ratio: 3 / 4;
    }
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.98);
    color: var(--color-white);
    inset: 0;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.98);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: transparent;
    border: 0;
    color: var(--color-white);
    cursor: pointer;
    padding: 0.5rem;
    line-height: 1;
    transition: opacity var(--transition);
  }

  .lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
    font-size: 2rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-close:hover {
    opacity: 0.7;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .lightbox-prev { left: 1.25rem; }
  .lightbox-next { right: 1.25rem; }

  .lightbox:hover .lightbox-prev,
  .lightbox:hover .lightbox-next,
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible {
    opacity: 0.85;
  }
  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 1 !important;
  }

  @media (max-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      display: none;
    }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const lbImg = lightbox.querySelector('.lightbox-img');
    const closeBtn = lightbox.querySelector('.lightbox-close');
    const prevBtn = lightbox.querySelector('.lightbox-prev');
    const nextBtn = lightbox.querySelector('.lightbox-next');
    const items = Array.from(document.querySelectorAll('.gallery-item'));
    const sources = items.map((b) => b.querySelector('img').src);
    const alts = items.map((b) => b.querySelector('img').alt);
    let idx = 0;

    const render = () => {
      lbImg.src = sources[idx];
      lbImg.alt = alts[idx];
    };
    const open = (i) => {
      idx = i;
      render();
      lightbox.showModal();
    };
    const close = () => lightbox.close();
    const prev = () => {
      idx = (idx - 1 + sources.length) % sources.length;
      render();
    };
    const next = () => {
      idx = (idx + 1) % sources.length;
      render();
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    let touchStartX = 0;
    lightbox.addEventListener(
      'touchstart',
      (e) => { touchStartX = e.changedTouches[0].screenX; },
      { passive: true }
    );
    lightbox.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(dx) > 50) {
        if (dx > 0) prev();
        else next();
      }
    });
  }
</script>
