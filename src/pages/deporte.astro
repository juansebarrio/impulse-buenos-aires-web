---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../components/layout/BaseLayout.astro';

const deporteDir = path.join(process.cwd(), 'public/images/deporte');
const galleryFiles = fs
  .readdirSync(deporteDir)
  .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort();
const galleryUrls = galleryFiles.map((f) => `/images/deporte/${f}`);
const heroImage = galleryUrls[0];

const description =
  'Impulse Deportes es la rama deportiva de Impulse Buenos Aires. Fútbol y vóley inclusivos para la comunidad LGBTIQ+, libres de discriminación.';

const futbolIG = 'https://www.instagram.com/impulsefutbolba/';
const voleyIG = 'https://www.instagram.com/impulsevoleyba/';
const sumarmeMailto =
  'mailto:juanse.barrio@aidshealth.org?subject=' +
  encodeURIComponent('Quiero sumarme a Impulse Deportes');
---

<BaseLayout title="Impulse Deporte — Fútbol y Vóley" description={description}>
  <!-- Hero -->
  <section class="hero" style={`background-image: url('${heroImage}');`}>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <p class="hero-eyebrow">Fútbol · Vóley · Comunidad</p>
      <h1 class="hero-title">
        El deporte como<br />herramienta de inclusión.
      </h1>
      <p class="hero-subtitle">
        Espacios deportivos seguros, libres de discriminación, para la
        comunidad LGBTIQ+.
      </p>
    </div>
  </section>

  <!-- Descripción -->
  <section class="intro">
    <div class="container intro-content">
      <p class="eyebrow">Impulse Deportes</p>
      <h2 class="intro-title">
        Una camiseta, dos disciplinas, un propósito.
      </h2>
      <p class="intro-text">
        Impulse Deportes nació con el deseo de crear espacios deportivos de
        pertenencia donde la comunidad LGBTIQ+ pueda jugar, entrenarse y
        competir en un entorno libre de discriminación. Cada partido, cada
        set, cada entrenamiento lleva nuestros valores: trato cordial,
        inclusión y hermandad.
      </p>
      <p class="intro-text">
        Usamos el deporte como puente para difundir mensajes de salud,
        respeto y comunidad. Porque cuidarse también se entrena.
      </p>
    </div>
  </section>

  <!-- Dos disciplinas -->
  <section class="disciplines">
    <div class="container">
      <p class="eyebrow disciplines-eyebrow">Nuestras disciplinas</p>
      <div class="disciplines-grid">
        <article class="card">
          <span class="card-num">01</span>
          <h3 class="card-title">Fútbol</h3>
          <p class="card-subtitle">Desde febrero de 2024</p>
          <p class="card-description">
            Nuestra primera disciplina. Un equipo unido por la pasión y el
            cuidado mutuo, donde competir y entrenar va de la mano con
            nuestros valores.
          </p>
          <a
            href={futbolIG}
            target="_blank"
            rel="noopener noreferrer"
            class="card-link"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
            </svg>
            Seguir a Impulse Fútbol
          </a>
        </article>

        <article class="card">
          <span class="card-num">02</span>
          <h3 class="card-title">Vóley</h3>
          <p class="card-subtitle">Desde mayo de 2025</p>
          <p class="card-description">
            La segunda disciplina que amplió nuestro impacto. Mismo
            espíritu, nueva cancha.
          </p>
          <a
            href={voleyIG}
            target="_blank"
            rel="noopener noreferrer"
            class="card-link"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
            </svg>
            Seguir a Impulse Vóley
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Galería -->
  <section class="gallery-section">
    <div class="container">
      <p class="eyebrow">En acción</p>
      <div class="gallery">
        {
          galleryUrls.map((src, i) => (
            <button class="gallery-item" data-index={i} aria-label={`Abrir foto ${i + 1}`}>
              <img
                src={src}
                alt={`Impulse Deportes — foto ${i + 1}`}
                loading="lazy"
              />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-content">
      <p class="eyebrow cta-eyebrow">Sumarte</p>
      <h2 class="cta-title">¿Querés jugar con nosotres?</h2>
      <p class="cta-text">
        Escribinos y te contamos sobre los entrenamientos, los días de
        práctica y cómo sumarte al equipo.
      </p>
      <a href={sumarmeMailto} class="cta-button">Quiero sumarme</a>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog id="lightbox" class="lightbox" aria-label="Visor de fotos">
    <button class="lightbox-close" aria-label="Cerrar visor">×</button>
    <button class="lightbox-prev" aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <img class="lightbox-img" alt="" />
    <button class="lightbox-next" aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </dialog>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 80vh;
    margin-top: -5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1rem;
    background-color: var(--color-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.2),
      rgba(0, 0, 0, 0.8)
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 960px;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 7vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    max-width: 500px;
    margin: 0 auto;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  /* ---------- Eyebrow compartido ---------- */
  .eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  /* ---------- Intro ---------- */
  .intro {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .intro { padding: 6rem 0; }
  }

  .intro-content {
    max-width: 720px;
  }

  .intro-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .intro-text + .intro-text {
    margin-top: 1.25rem;
  }

  /* ---------- Disciplinas ---------- */
  .disciplines {
    background-color: var(--color-surface);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .disciplines { padding: 6rem 0; }
  }

  .disciplines-eyebrow {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .disciplines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .disciplines-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .card {
    background-color: var(--color-surface-2);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .card { padding: 3rem; }
  }

  .card-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .card-subtitle {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1.5rem;
  }

  .card-description {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    transition: color var(--transition);
  }
  .card-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  /* ---------- Galería ---------- */
  .gallery-section {
    background-color: var(--color-bg);
    padding: 4rem 0 6rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .gallery-item {
    display: block;
    width: 100%;
    height: 220px;
    padding: 0;
    border: 0;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .gallery-item { height: 280px; }
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }
  .gallery-item:hover img {
    transform: scale(1.04);
  }

  /* ---------- CTA ---------- */
  .cta {
    background-color: #000;
    padding: 5rem 0;
  }
  @media (min-width: 768px) {
    .cta { padding: 7.5rem 0; }
  }

  .cta-content {
    text-align: center;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-eyebrow {
    margin-bottom: 1.25rem;
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .cta-text {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.8vw, 19px);
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 560px;
  }

  .cta-button {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-white);
    padding: 14px 28px;
    border-radius: 4px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    border: 1px solid var(--color-accent);
    transition: background-color var(--transition), border-color var(--transition);
  }
  .cta-button:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.95);
    color: var(--color-white);
    inset: 0;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.95);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: transparent;
    border: 0;
    color: var(--color-white);
    cursor: pointer;
    padding: 0.75rem;
    line-height: 1;
    transition: opacity var(--transition);
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 0.7;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
    font-size: 2rem;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    display: none;
  }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  @media (min-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      display: block;
    }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const lbImg = lightbox.querySelector('.lightbox-img');
    const closeBtn = lightbox.querySelector('.lightbox-close');
    const prevBtn = lightbox.querySelector('.lightbox-prev');
    const nextBtn = lightbox.querySelector('.lightbox-next');
    const items = Array.from(document.querySelectorAll('.gallery-item'));
    const sources = items.map((b) => b.querySelector('img').src);
    const alts = items.map((b) => b.querySelector('img').alt);
    let idx = 0;

    const render = () => {
      lbImg.src = sources[idx];
      lbImg.alt = alts[idx];
    };
    const open = (i) => {
      idx = i;
      render();
      lightbox.showModal();
    };
    const close = () => lightbox.close();
    const prev = () => {
      idx = (idx - 1 + sources.length) % sources.length;
      render();
    };
    const next = () => {
      idx = (idx + 1) % sources.length;
      render();
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    let touchStartX = 0;
    lightbox.addEventListener(
      'touchstart',
      (e) => { touchStartX = e.changedTouches[0].screenX; },
      { passive: true }
    );
    lightbox.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(dx) > 50) {
        if (dx > 0) prev();
        else next();
      }
    });
  }
</script>
