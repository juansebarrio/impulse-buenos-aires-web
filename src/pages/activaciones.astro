---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../components/layout/BaseLayout.astro';

const activacionesDir = path.join(process.cwd(), 'public/images/activaciones');
const galleryFiles = fs
  .readdirSync(activacionesDir)
  .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort();
const galleryUrls = galleryFiles.map((f) => `/images/activaciones/${f}`);

const heroImage = '/images/activaciones/Impulse-69.jpg';

const contactMailto = 'mailto:juanse.barrio@aidshealth.org';

const description =
  'Impulse Buenos Aires lleva testeos, insumos y prevención directamente a la calle. Activismo territorial en la comunidad LGBTIQ+ de Buenos Aires.';
---

<BaseLayout title="Activaciones Urbanas" description={description}>
  <!-- Hero -->
  <section class="hero" style={`background-image: url('${heroImage}');`}>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <p class="hero-eyebrow">En el territorio</p>
      <h1 class="hero-title">
        Buenos Aires es una ciudad viva.<br />Nuestro activismo también.
      </h1>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro">
    <div class="container intro-content">
      <p class="eyebrow">Activaciones urbanas</p>
      <h2 class="intro-title">Donde está la gente, estamos nosotres.</h2>
      <p class="intro-text">
        Salimos a la calle porque creemos que la información tiene que
        llegar donde vive la comunidad. Testeos rápidos, entrega de
        insumos, material de prevención y presencia real en los espacios
        donde nos encontramos. Sin consultorios, sin barreras, sin
        burocracia.
      </p>
    </div>
  </section>

  <!-- Galería masonry -->
  <section class="gallery-section">
    <div class="container">
      <div class="masonry">
        {
          galleryUrls.map((src, i) => (
            <button class="masonry-item" data-index={i} aria-label={`Abrir foto ${i + 1}`}>
              <img
                src={src}
                alt={`Activación urbana — foto ${i + 1}`}
                loading="lazy"
              />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-content">
      <div class="cta-text">
        <h2 class="cta-title">¿Querés participar en una activación?</h2>
        <p class="cta-subtitle">
          Escribinos y te sumamos al próximo operativo.
        </p>
      </div>
      <a href={contactMailto} class="cta-button">Contactanos</a>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog id="lightbox" class="lightbox" aria-label="Visor de fotos">
    <button class="lightbox-close" aria-label="Cerrar visor">×</button>
    <button class="lightbox-prev" aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <img class="lightbox-img" alt="" />
    <button class="lightbox-next" aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" aria-hidden="true">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </dialog>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 70vh;
    margin-top: -5rem;
    display: flex;
    align-items: flex-end;
    padding-bottom: 4rem;
    background-color: var(--color-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 0.85)
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1000px;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 8vw, 80px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  /* ---------- Eyebrow compartido ---------- */
  .eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  /* ---------- Intro ---------- */
  .intro {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .intro { padding: 6rem 0; }
  }

  .intro-content {
    max-width: 680px;
  }

  .intro-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ---------- Galería masonry ---------- */
  .gallery-section {
    background-color: var(--color-bg);
    padding-bottom: 6rem;
  }

  .masonry {
    column-count: 1;
    column-gap: 8px;
  }
  @media (min-width: 640px) {
    .masonry {
      column-count: 2;
    }
  }
  @media (min-width: 1024px) {
    .masonry {
      column-count: 3;
    }
  }

  .masonry-item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    margin: 0 0 8px;
    cursor: pointer;
    break-inside: avoid;
    overflow: hidden;
  }

  .masonry-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: filter 0.25s ease;
  }

  .masonry-item:hover img {
    filter: brightness(0.85);
  }

  /* ---------- CTA ---------- */
  .cta {
    background-color: var(--color-surface);
    padding: 3.75rem 0;
  }
  @media (min-width: 768px) {
    .cta { padding: 5rem 0; }
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .cta-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 2.5rem;
    }
  }

  .cta-text {
    max-width: 640px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.5vw, 36px);
    line-height: 1.1;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .cta-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-muted);
  }

  .cta-button {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 4px;
    border: 1px solid var(--color-white);
    background: transparent;
    color: var(--color-white);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    transition: background-color var(--transition);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .cta-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.95);
    color: var(--color-white);
    inset: 0;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.95);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: transparent;
    border: 0;
    color: var(--color-white);
    cursor: pointer;
    padding: 0.75rem;
    line-height: 1;
    transition: opacity var(--transition);
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 0.7;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
    font-size: 2rem;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    display: none;
  }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  @media (min-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      display: block;
    }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const lbImg = lightbox.querySelector('.lightbox-img');
    const closeBtn = lightbox.querySelector('.lightbox-close');
    const prevBtn = lightbox.querySelector('.lightbox-prev');
    const nextBtn = lightbox.querySelector('.lightbox-next');
    const items = Array.from(document.querySelectorAll('.masonry-item'));
    const sources = items.map((b) => b.querySelector('img').src);
    const alts = items.map((b) => b.querySelector('img').alt);
    let idx = 0;

    const render = () => {
      lbImg.src = sources[idx];
      lbImg.alt = alts[idx];
    };
    const open = (i) => {
      idx = i;
      render();
      lightbox.showModal();
    };
    const close = () => lightbox.close();
    const prev = () => {
      idx = (idx - 1 + sources.length) % sources.length;
      render();
    };
    const next = () => {
      idx = (idx + 1) % sources.length;
      render();
    };

    items.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    let touchStartX = 0;
    lightbox.addEventListener(
      'touchstart',
      (e) => { touchStartX = e.changedTouches[0].screenX; },
      { passive: true }
    );
    lightbox.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(dx) > 50) {
        if (dx > 0) prev();
        else next();
      }
    });
  }
</script>
