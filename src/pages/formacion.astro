---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { ciclo, docentes, encuentros } from '../data/formacion';

const description =
  'Ciclo de formación virtual y gratuito de Impulse Buenos Aires. Cinco encuentros sobre sexualidades, salud comunitaria, VIH, reducción de daños y territorios de acción. Inscripción abierta.';

const docentePorId = (id: string) => docentes.find((d) => d.id === id);

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${ciclo.nombre}: ${ciclo.titulo}`,
  description,
  url: new URL('/formacion', Astro.site ?? Astro.url).toString(),
  provider: {
    '@type': 'Organization',
    name: 'Impulse Buenos Aires',
    url: 'https://www.impulsebuenosaires.org',
  },
  isAccessibleForFree: true,
  courseMode: 'Online',
};
---

<BaseLayout
  title="Ciclo de Formación: Sexualidades y Salud Comunitaria"
  description={description}
  ogImage="/images/formacion/og.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <!-- Hero -->
  <section id="hero-formacion" class="hero">
    <div class="container hero-content">
      <p class="hero-eyebrow">{ciclo.nombre} · Virtual y gratuito</p>
      <h1 class="hero-title">{ciclo.titulo}</h1>
      <p class="hero-sub">{ciclo.subtitulo}</p>
      <p class="hero-bajada">
        Las conquistas del movimiento LGTB+ abrieron caminos fundamentales,
        pero las desigualdades estructurales, la discriminación y las
        barreras en el acceso a la salud siguen presentes en la vida
        cotidiana. Este ciclo de formación propone encontrarnos para pensar
        la sexualidad no como una categoría fija, sino como un campo
        político, de resistencia y de disputa social, recuperando la
        historia de nuestras luchas para transformar el presente desde el
        territorio y los cuidados colectivos.
      </p>
      <ul class="hero-chips" role="list">
        <li class="chip">{encuentros.length} encuentros</li>
        <li class="chip">{ciclo.modalidad}</li>
        <li class="chip">{ciclo.costo}</li>
      </ul>
      <div class="hero-buttons">
        <a
          href={ciclo.inscripcionURL}
          target="_blank"
          rel="noopener"
          class="btn btn-primary plausible-event-name=Inscripcion+Formacion"
        >
          Inscribirme
        </a>
        <a href="#programa" class="btn btn-secondary">Ver el programa</a>
      </div>
    </div>
  </section>

  <!-- Sobre el ciclo -->
  <section class="sobre">
    <div class="container sobre-content">
      <p class="eyebrow">Sobre el ciclo</p>
      <h2 class="section-title">Cinco encuentros para pensar, cuidar y actuar.</h2>
      <p class="sobre-text">
        Partimos de una idea: la disidencia sexual es una práctica política,
        una crítica a las normas que organizan la vida social. La
        heterosexualidad obligatoria, el binarismo sexo-género y las
        violencias sobre las identidades no normativas son dispositivos que
        vamos a poner en cuestión durante el ciclo, recuperando la historia
        de quienes los disputaron antes que nosotres.
      </p>
      <p class="sobre-text">
        También vamos a hablar de salud desde una perspectiva comunitaria:
        cómo funciona el sistema de salud, qué políticas públicas existen
        sobre sexualidades y derechos sexuales y reproductivos, y qué
        herramientas hay para fortalecer la autonomía y la participación.
        Salud mental, redes de apoyo, trabajo entre pares, reducción de
        daños en contextos de fiesta y sexo, y los territorios donde todo
        eso pasa: la calle, las marchas, la cancha, las fiestas, los
        cuerpos y las redes afectivas.
      </p>
      <p class="sobre-text">
        Cinco encuentros virtuales y gratuitos para salir con una mirada
        crítica sobre las sexualidades y con herramientas concretas para
        intervenir en tu comunidad.
      </p>
    </div>
  </section>

  <!-- Programa -->
  <section id="programa" class="programa">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Programa</p>
        <h2 class="section-title">Cinco encuentros.</h2>
      </header>

      <div class="encuentros">
        {
          encuentros.map((e) => {
            const docente = docentePorId(e.docenteId);
            return (
              <article class="encuentro-card">
                <span class="encuentro-num">{String(e.numero).padStart(2, '0')}</span>
                {e.fecha && <p class="encuentro-fecha">{e.fecha}</p>}
                <h3 class="encuentro-titulo">{e.titulo}</h3>

                {docente && (
                  <a class="encuentro-docente" href={`#${docente.id}`}>
                    <img
                      src={docente.foto}
                      alt={`Foto de ${docente.nombre}`}
                      loading="lazy"
                      class="encuentro-docente-foto"
                    />
                    <span class="encuentro-docente-info">
                      <span class="encuentro-docente-nombre">{docente.nombre}</span>
                      <span class="encuentro-docente-rol">{docente.rol}</span>
                    </span>
                  </a>
                )}

                <p class="encuentro-desc">{e.descripcion}</p>

                <ul class="encuentro-preguntas" role="list">
                  {e.preguntas.map((pregunta) => (
                    <li>{pregunta}</li>
                  ))}
                </ul>

                {e.objetivos.length > 0 && (
                  <details class="encuentro-objetivos">
                    <summary>Objetivos del encuentro</summary>
                    <ul>
                      {e.objetivos.map((objetivo) => (
                        <li>{objetivo}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Docentes -->
  <section class="docentes">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Docentes</p>
        <h2 class="section-title">Quiénes dan las clases.</h2>
      </header>

      <div class="docentes-lista">
        {
          docentes.map((d) => (
            <article id={d.id} class="docente-ficha">
              <img
                src={d.foto}
                alt={`Foto de ${d.nombre}`}
                loading="lazy"
                class="docente-foto"
              />
              <div>
                <h3 class="docente-nombre">{d.nombre}</h3>
                <p class="docente-rol">{d.rol}</p>
                <p class="docente-bio">{d.bio}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="docentes-coordinan">Coordinan: {ciclo.coordinan}.</p>
    </div>
  </section>

  <!-- Inscripción -->
  <section id="inscripcion" class="inscripcion">
    <div class="container inscripcion-content">
      <p class="eyebrow">Inscripción</p>
      <h2 class="section-title">Es gratuito. Anotate.</h2>
      <p class="inscripcion-text">Completá el formulario para reservar tu lugar.</p>
      <iframe
        src={ciclo.inscripcionURL}
        title="Formulario de inscripción"
        class="inscripcion-iframe"
        loading="lazy"
      ></iframe>
      <a
        href={ciclo.inscripcionURL}
        target="_blank"
        rel="noopener"
        class="btn btn-primary plausible-event-name=Inscripcion+Formacion"
      >
        Inscribirme
      </a>
    </div>
  </section>

  <!-- Barra fija de inscripción (solo mobile) -->
  <div id="inscripcion-bar" class="inscripcion-bar">
    <a
      href={ciclo.inscripcionURL}
      target="_blank"
      rel="noopener"
      class="btn btn-primary inscripcion-bar-btn plausible-event-name=Inscripcion+Formacion"
    >
      Inscribirme
    </a>
  </div>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    margin-top: -5rem;
    padding: 9rem 0 4.5rem;
    background: linear-gradient(to bottom, var(--color-surface), var(--color-bg));
  }
  @media (min-width: 768px) {
    .hero {
      padding: 11rem 0 6rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 860px;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .hero-bajada {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 720px;
    margin-bottom: 2rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin-bottom: 2.5rem;
  }

  .chip {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 360px;
  }
  @media (min-width: 640px) {
    .hero-buttons {
      flex-direction: row;
      gap: 1rem;
      width: auto;
      max-width: none;
    }
  }

  /* ---------- Botones ---------- */
  .btn {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 4px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    border: 1px solid transparent;
    transition: background-color var(--transition), border-color var(--transition);
    cursor: pointer;
    text-align: center;
  }
  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-white);
    border-color: var(--color-accent);
  }
  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-white);
    border-color: var(--color-white);
  }
  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  /* ---------- Eyebrow y títulos compartidos ---------- */
  .eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  /* ---------- Sobre el ciclo ---------- */
  .sobre {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .sobre {
      padding: 6rem 0;
    }
  }

  .sobre-content {
    max-width: 680px;
  }

  .sobre .section-title {
    margin-bottom: 1.5rem;
  }

  .sobre-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .sobre-text + .sobre-text {
    margin-top: 1.25rem;
  }

  /* ---------- Programa ---------- */
  .programa {
    background-color: var(--color-surface);
    padding: 4rem 0;
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .programa {
      padding: 6rem 0;
    }
  }

  .encuentros {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .encuentros {
      gap: 1.5rem;
    }
  }

  .encuentro-card {
    background-color: var(--color-surface-2);
    border-radius: 4px;
    padding: 2rem 1.5rem;
  }
  @media (min-width: 768px) {
    .encuentro-card {
      padding: 2.5rem;
    }
  }

  .encuentro-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 48px;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .encuentro-fecha {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .encuentro-titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.1;
    color: var(--color-white);
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .encuentro-docente {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .encuentro-docente:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .encuentro-docente-foto {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .encuentro-docente-info {
    display: flex;
    flex-direction: column;
  }

  .encuentro-docente-nombre {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    transition: color var(--transition);
  }
  .encuentro-docente:hover .encuentro-docente-nombre {
    color: var(--color-accent);
  }

  .encuentro-docente-rol {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .encuentro-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .encuentro-preguntas {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .encuentro-preguntas li {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text);
    border-left: 3px solid var(--color-accent);
    padding-left: 1.1rem;
  }

  .encuentro-objetivos summary {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-accent);
    cursor: pointer;
    width: fit-content;
    transition: color var(--transition);
  }
  .encuentro-objetivos summary:hover {
    color: var(--color-accent-hover);
  }
  .encuentro-objetivos summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .encuentro-objetivos ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .encuentro-objetivos li {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* ---------- Docentes ---------- */
  .docentes {
    background-color: var(--color-bg);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .docentes {
      padding: 6rem 0;
    }
  }

  .docentes-lista {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .docentes-lista {
      gap: 3rem;
    }
  }

  .docente-ficha {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    scroll-margin-top: 6rem;
  }
  @media (min-width: 768px) {
    .docente-ficha {
      flex-direction: row;
      gap: 2rem;
      align-items: flex-start;
    }
  }

  .docente-foto {
    width: 120px;
    height: 120px;
    border-radius: var(--radius);
    object-fit: cover;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .docente-foto {
      width: 160px;
      height: 160px;
    }
  }

  .docente-nombre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    color: var(--color-white);
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .docente-rol {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .docente-bio {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 760px;
  }

  .docentes-coordinan {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
  }

  /* ---------- Inscripción ---------- */
  .inscripcion {
    background-color: var(--color-surface);
    padding: 4rem 0;
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .inscripcion {
      padding: 6rem 0;
    }
  }

  .inscripcion-content {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .inscripcion .section-title {
    margin-bottom: 1rem;
  }

  .inscripcion-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .inscripcion-iframe {
    width: 100%;
    min-height: 720px;
    border: 0;
    border-radius: 4px;
    background-color: var(--color-surface-2);
    margin-bottom: 1.5rem;
  }

  /* ---------- Barra fija de inscripción (mobile) ---------- */
  .inscripcion-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    padding: 0.75rem 16px calc(0.75rem + env(safe-area-inset-bottom));
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    transform: translateY(100%);
    visibility: hidden;
    transition: transform 0.25s ease, visibility 0.25s;
  }
  .inscripcion-bar.is-visible {
    transform: translateY(0);
    visibility: visible;
  }
  .inscripcion-bar-btn {
    display: block;
    width: 100%;
  }
  @media (min-width: 768px) {
    .inscripcion-bar {
      display: none;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero-formacion');
  const bar = document.getElementById('inscripcion-bar');
  if (hero && bar) {
    new IntersectionObserver(([entry]) => {
      bar.classList.toggle('is-visible', !entry.isIntersecting);
    }).observe(hero);
  }
</script>
