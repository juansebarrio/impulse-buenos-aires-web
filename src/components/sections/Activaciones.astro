---
const activacionesImages = [
  '/images/activaciones/005---190216-Impulse-día-del-preservativo-__EDU0940_.jpg',
  '/images/activaciones/044---190216-Impulse-día-del-preservativo-__EDU1006_.jpg',
];
---

<section class="activaciones">
  <div class="container">
    <div class="activaciones-grid">
      {
        activacionesImages.map((src, i) => (
          <div class="activaciones-photo">
            <img
              src={src}
              alt={`Activación urbana — foto ${i + 1}`}
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
    <div class="activaciones-text">
      <p class="eyebrow">En el territorio</p>
      <h2 class="title">Donde está la gente, estamos nosotres.</h2>
      <p class="description">
        Testeos, entrega de insumos, información y presencia en los espacios
        donde la comunidad vive y se encuentra.
      </p>
      <a href="/activaciones" class="cta">Ver activaciones →</a>
    </div>
  </div>
</section>

<style>
  .activaciones {
    background-color: var(--color-surface);
    padding: 4rem 0;
  }
  @media (min-width: 768px) {
    .activaciones {
      padding: 6rem 0;
    }
  }

  .activaciones-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .activaciones-grid {
      gap: 1.5rem;
      margin-bottom: 3.5rem;
    }
  }

  .activaciones-photo {
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
  }
  .activaciones-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .activaciones-text {
    max-width: 720px;
  }

  .eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .description {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 1.75rem;
  }

  .cta {
    color: var(--color-accent);
    font-weight: 600;
    transition: color var(--transition);
  }
  .cta:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }
</style>
